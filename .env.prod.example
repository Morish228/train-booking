# =============================================================================
# IRCTC train-booking — PRODUCTION environment template
# =============================================================================
#
# HOW THIS MAPS TO THE SERVER
#
#   App services (8x Node) run NATIVELY on the host via PM2  ->  localhost
#   Infrastructure (Postgres/Redis/Kafka/ES) runs in Docker, ports published
#   to 127.0.0.1 by docker-compose.prod.yml                ->  127.0.0.1
#
#   So hosts stay essentially the SAME as local, EXCEPT:
#     - Postgres:  [::1]:5432  ->  127.0.0.1:5432
#       (the [::1] was a laptop-only workaround for a WSL stack that was
#        shadowing localhost; on a clean server it does not exist)
#     - every PASSWORD changes
#
#   Copy each section below into <service>/.env on the server.
#   These files are gitignored — they never go into the repo.
#
# STORAGE / CONNECTION SUMMARY (what this file decides)
#
#   Postgres     127.0.0.1:5432   one DB per service (5 DBs, see below)
#   Redis        127.0.0.1:6379   password required
#   Kafka        127.0.0.1:9093   host listener (internal name is kafka:9092)
#   Elasticsearch 127.0.0.1:9200
#
# =============================================================================


# -----------------------------------------------------------------------------
# SECRETS — generate fresh. Do NOT reuse the laptop values.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET  must be IDENTICAL in
#   api-gateway and user-service.
# INTERNAL_SERVICE_KEY  must be IDENTICAL across
#   user, booking, payment, inventory, admin.
# -----------------------------------------------------------------------------

POSTGRES_PASSWORD=__change_me__
REDIS_PASSWORD=__change_me__
PGADMIN_PASSWORD=__change_me__

JWT_ACCESS_SECRET=__64_hex__
JWT_REFRESH_SECRET=__128_hex__
OTP_HMAC_SECRET=__64_hex__
INTERNAL_SERVICE_KEY=__64_hex__


# =============================================================================
# API-GATEWAY  (port 4000)
# =============================================================================
PORT=4000
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://__your_domain__

REDIS_URL=redis://:__REDIS_PASSWORD__@127.0.0.1:6379

JWT_ACCESS_SECRET=__same_as_user_service__
JWT_REFRESH_SECRET=__same_as_user_service__
ACCESS_TOKEN_EXP=15m
REFRESH_TOKEN_EXP=7d
ACCESS_TOKEN_EXP_SEC=900
REFRESH_TOKEN_EXP_SEC=604800

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Inter-service: all 8 services live on the host, so plain localhost ports.
USER_SERVICE_URL=http://localhost:4001
SEARCH_SERVICE_URL=http://localhost:4002
ADMIN_SERVICE_URL=http://localhost:4003
NOTIFICATION_SERVICE_URL=http://localhost:4004
BOOKING_SERVICE_URL=http://localhost:4005
PAYMENT_SERVICE_URL=http://localhost:4006
INVENTORY_SERVICE_URL=http://localhost:4007

SERVICE_TIMEOUT_MS=60000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000


# =============================================================================
# USER-SERVICE  (port 4001)   — owns user_service_database
# =============================================================================
PORT=4001
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://__your_domain__

DATABASE_URL=postgres://admin:__POSTGRES_PASSWORD__@127.0.0.1:5432/user_service_database
REDIS_URL=redis://:__REDIS_PASSWORD__@127.0.0.1:6379
KAFKA_BROKER=127.0.0.1:9093
KAFKA_CLIENT_ID=user-service

OTP_TTL=300
OTP_HMAC_SECRET=__64_hex__
OTP_RATE_MAX_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

JWT_ACCESS_SECRET=__same_as_api_gateway__
JWT_REFRESH_SECRET=__same_as_api_gateway__
ACCESS_TOKEN_EXP=15m
REFRESH_TOKEN_EXP=7d
ACCESS_TOKEN_EXP_SEC=900
REDIS_USER_TTL=86400

INTERNAL_SERVICE_KEY=__shared__

# Google OAuth. ID-token flow — console needs Authorized JavaScript ORIGINS
# (https://__your_domain__), not redirect URIs.
GOOGLE_CLIENT_ID=__from_google_console__
GOOGLE_CLIENT_SECRET=__from_google_console__


# =============================================================================
# SEARCH-SERVICE  (port 4002)   — no DB; Elasticsearch only
# =============================================================================
PORT=4002
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://__your_domain__

ELASTICSEARCH_URL=http://127.0.0.1:9200
KAFKA_BROKER=127.0.0.1:9093
KAFKA_CLIENT_ID=search-service

# Set to true ONCE on first boot to build indices, then false.
# Leaving it true wipes and rebuilds indices on every restart.
ES_RECREATE_INDICES=false


# =============================================================================
# ADMIN-SERVICE  (port 4003)   — owns admin_service_database
# =============================================================================
PORT=4003
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://__your_domain__

DATABASE_URL=postgres://admin:__POSTGRES_PASSWORD__@127.0.0.1:5432/admin_service_database
KAFKA_BROKER=127.0.0.1:9093
KAFKA_CLIENT_ID=admin-service

INTERNAL_SERVICE_KEY=__shared__


# =============================================================================
# NOTIFICATION-SERVICE  (no port — Kafka consumer only)
# =============================================================================
PORT=4004
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://__your_domain__

KAFKA_BROKER=127.0.0.1:9093
KAFKA_CLIENT_ID=notification-service

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=__your_gmail__
SMTP_PASS=__16_char_google_app_password__
MAIL_SEND=__must_equal_SMTP_USER__

FRONTEND_URL=https://__your_domain__/login


# =============================================================================
# BOOKING-SERVICE  (port 4005)   — owns booking_service_database
# =============================================================================
PORT=4005
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://__your_domain__

DATABASE_URL=postgres://admin:__POSTGRES_PASSWORD__@127.0.0.1:5432/booking_service_database
KAFKA_BROKER=127.0.0.1:9093
KAFKA_CLIENT_ID=booking-service
REDIS_URL=redis://:__REDIS_PASSWORD__@127.0.0.1:6379

INVENTORY_SERVICE_URL=http://localhost:4007
PAYMENT_SERVICE_URL=http://localhost:4006
USER_SERVICE_URL=http://localhost:4001
ADMIN_SERVICE_URL=http://localhost:4003
INTERNAL_SERVICE_KEY=__shared__

BOOKING_TTL_SECONDS=600
BOOKING_EXPIRY_CHECK_INTERVAL_MS=30000
LOCK_TTL_SECONDS=600


# =============================================================================
# PAYMENT-SERVICE  (port 4006)   — owns payment_service_database
# =============================================================================
PORT=4006
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://__your_domain__

DATABASE_URL=postgres://admin:__POSTGRES_PASSWORD__@127.0.0.1:5432/payment_service_database
KAFKA_BROKER=127.0.0.1:9093
KAFKA_CLIENT_ID=payment-service

INTERNAL_SERVICE_KEY=__shared__

PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=__razorpay_secret__
# From the Razorpay dashboard -> Webhooks -> the secret YOU set.
# Test Mode and Live Mode have SEPARATE webhooks and secrets.
RAZORPAY_WEBHOOK_SECRET=__razorpay_webhook_secret__


# =============================================================================
# INVENTORY-SERVICE  (port 4007)   — owns inventory_service_database
# =============================================================================
PORT=4007
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://__your_domain__

DATABASE_URL=postgres://admin:__POSTGRES_PASSWORD__@127.0.0.1:5432/inventory_service_database
KAFKA_BROKER=127.0.0.1:9093
KAFKA_CLIENT_ID=inventory-service

LOCK_TTL_SECONDS=300
LOCK_EXPIRY_INTERVAL_MS=60000
INTERNAL_SERVICE_KEY=__shared__


# =============================================================================
# FRONTEND  (frontend/.env — read at BUILD time by Vite)
# =============================================================================
# Local used a relative "/api" relying on Vite's dev proxy. In production the
# SPA is served by Caddy on the same origin as the gateway, so if Caddy
# reverse-proxies /api -> localhost:4000 this can stay relative.
# If you ever serve the SPA from a DIFFERENT origin (e.g. Vercel), this MUST
# become absolute AND the cookies need sameSite=none in auth.controller.js.
VITE_API_BASE_URL=/api
